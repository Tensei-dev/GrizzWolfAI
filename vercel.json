{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "framework": null,
    "buildCommand": "node scripts/copy-vendor.js",
    "outputDirectory": "public",
    "regions": ["cle1"],
    "functions": {
        "api/index.js": {
            "maxDuration": 60
        }
    },
    "rewrites": [
        { "source": "/api/(.*)", "destination": "/api" }
    ]
}
